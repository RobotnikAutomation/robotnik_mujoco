<mujoco model="rough terrain world">

  <include file="../models/rbsummit/rbsummit.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize="0.04"/>

  <visual>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- https://www.artstation.com/artwork/gwbX8 -->
    <texture type="2d" name="groundplane" file="assets/stone-1024.png"/>
    
    <!-- material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance=".8"/ -->
    <material name="groundplane" texture="groundplane"
              texuniform="true" texrepeat="5 5"
              reflectance="0.8" specular="0.3" shininess="1"/>

    <!-- ground elevation map according to hfield pattern (grey level is proportional to height) on 10 x 10 m surface with max 0.05 elevation at 1.0 scale -->
    <!-- hfield name="hfield" file="assets/hfield.png" size="10 10 .05 1.0"/ -->
    <hfield name="hfield" file="assets/hfield.png" size="10 10 .10 1.0"/>
    
    <!-- sky color -->
    <texture builtin="gradient" name="sky" type="skybox"
              rgb1="0.6 0.7 1" rgb2="0.2 0.3 0.6" width="100" height="100"/>
 
  </asset>

  <worldbody>
	<!-- light diffuse=".7 .7 .7" pos="0 0 10" dir="0 0 -1" / -->
	<light diffuse="1 1 1"
           ambient="0.3 0.3 0.3"
           specular="0.2 0.2 0.2"
           directional="true"
           pos="0 0 5"
           dir="0 0 -1"
           castshadow="true"/>
	      
    <geom name="floor" type="hfield" hfield="hfield"
          material="groundplane"
          contype="1" conaffinity="0" priority="1"
          friction="1.0"/>
          
    <!-- sand type - softer and less friction, to be tested -->
    <!-- geom name="floor" type="hfield" hfield="hfield"
          material="groundplane"
          contype="1" conaffinity="0" priority="1"
          friction="0.9 0.01 0.01"
          solref="0.03 1"
          solimp="0.9 0.99 0.001"/ -->
          
  </worldbody>

</mujoco>
